# All variables are optional. The app runs fully without any of them.

# Path to a Chromium binary for scanning. Leave unset to use the browser
# installed by `npx playwright install chromium`.
A11Y_CHROMIUM_PATH=

# Figma personal access token, used server side only for live file import.
# Without it, Figma import accepts a JSON export instead.
FIGMA_ACCESS_TOKEN=

# Optional AI explanations for manual-review findings. Off unless both are set.
# Scanned content is sent to this provider when enabled, and the UI says so.
AI_PROVIDER=
ANTHROPIC_API_KEY=
AI_MODEL=

# Development only: comma separated host:port pairs the URL scanner may reach
# even though they are private (for example a local fixture server).
# Ignored when NODE_ENV is production.
SCAN_DEV_ALLOWLIST=
